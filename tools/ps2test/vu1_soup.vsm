; VU1 microprogram for triangle soup: three corners a triangle, no indices.
;
; Per batch the VIF has unpacked, into the double buffer at TOP:
;   +0 .. +6   the GS state packet (a GIF tag for A+D, six register writes)
;   +7         the GIF tag of the vertices (NLOOP = the number of corners)
;   +8 + 3 i   corner i: +0 its texture coordinates (u, v as integers), +1 its colour (r, g, b, a as integers),
;              +2 its position (x, y, z as integers over the primitive's range, w 0)
; Constants at the start of VU memory:
;   0 1 2  the clip-space matrix's columns, with the position's scale folded in; 3 the clip-space position of a zero position
;   4  the screen scale (x, y, z)  5 the screen offset (x, y, z)  6 the texture coordinates' scale  7 their offset
;   8  the guard-band scale of the clip test (1/3, 1/3, 1, 1)
; The program turns each corner into what the GS takes in packed form (ST, RGBAQ, XYZ2) in place, then kicks the buffer.
		.vu
		.align 4
		.global	VU1Soup_CodeStart
		.global	VU1Soup_CodeEnd
VU1Soup_CodeStart:
         NOP                                        lq            VF01,0(VI00)
         NOP                                        lq            VF02,1(VI00)
         NOP                                        lq            VF03,2(VI00)
         NOP                                        lq            VF04,3(VI00)
         NOP                                        lq            VF05,4(VI00)
         NOP                                        lq            VF06,5(VI00)
         NOP                                        lq            VF07,6(VI00)
         NOP                                        lq            VF08,7(VI00)
         NOP                                        lq            VF09,8(VI00)
         NOP                                        xtop          VI02
         NOP                                        ilw.x         VI07,7(VI02)
         NOP                                        iaddiu        VI03,VI02,8
         NOP                                        fcset         0
         NOP                                        iaddiu        VI08,VI00,0x00007fff
         NOP                                        NOP
         NOP                                        iand          VI07,VI07,VI08
         NOP                                        NOP
cornerLoop:
         NOP                                        lq            VF10,2(VI03)
         NOP                                        lq            VF11,0(VI03)
         itof0         VF10,VF10                    NOP
         itof0.xy      VF11,VF11                    NOP
         mulax         ACC,VF01,VF10x               NOP
         madday        ACC,VF02,VF10y               NOP
         maddaz        ACC,VF03,VF10z               NOP
         maddw         VF12,VF04,VF00w              NOP
         mul           VF13,VF12,VF09               NOP
         mul.xy        VF14,VF11,VF07               NOP
         clipw.xyz     VF13xyz,VF12w                div           Q,VF00w,VF12w
         add.xy        VF14,VF14,VF08               NOP
         addw.z        VF14,VF00,VF00w              NOP
         NOP                                        NOP
         NOP                                        NOP
         mulq          VF14,VF14,Q                  fcand         VI01,262143
         mulq.xyz      VF15,VF12,Q                  iaddiu        VI01,VI01,0x00007fff
         mul.xyz       VF15,VF15,VF05               NOP
         add.xyz       VF15,VF15,VF06               NOP
         ftoi4.xy      VF16,VF15                    NOP
         ftoi0.z       VF16,VF15                    sq            VF14,0(VI03)
         NOP                                        sq.xyz        VF16,2(VI03)
         NOP                                        isw.w         VI01,2(VI03)
         NOP                                        iaddiu        VI03,VI03,3
         NOP                                        isubiu        VI07,VI07,1
         NOP                                        NOP
         NOP                                        ibne          VI07,VI00,cornerLoop
         NOP                                        NOP
         NOP                                        xgkick        VI02
         NOP[E]                                     NOP
         NOP                                        NOP
		.align 4
VU1Soup_CodeEnd:
